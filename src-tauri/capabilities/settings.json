{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "Settings and onboarding window permissions",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "autostart:default",
    "global-shortcut:default",
    "os:default",
    "process:allow-restart",
    "store:default",
    "updater:default"
  ]
}

