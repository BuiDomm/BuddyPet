{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuddyPet",
  "version": "0.1.0",
  "identifier": "app.buddypet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "BuddyPet",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; media-src 'self' asset: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons-v2/32x32.png",
      "icons-v2/128x128.png",
      "icons-v2/128x128@2x.png",
      "icons-v2/icon.icns",
      "icons-v2/icon.ico"
    ],
    "category": "Lifestyle",
    "shortDescription": "A playful desktop companion that reminds you to take breaks.",
    "longDescription": "BuddyPet is a privacy-first desktop companion that plays harmless visual pranks and encourages healthy breaks.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons-v2/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": []
    }
  }
}
